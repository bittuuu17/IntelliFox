# Local testing — copy this file to ".env" in the same folder as main.py (never commit .env).
# PowerShell: Copy-Item .env.example .env

RUN_ENV=local

# ── Gemini backend (choose ONE) ─────────────────────────────────────────────
#
# A) Gemini Developer API (AI Studio key — ai.google.dev, generativelanguage.googleapis.com)
GEMINI_API_KEY=
#
# B) Vertex AI on Google Cloud (GCP Gen AI — billed to your project / hackathon credits)
#    Enable Vertex AI API on the project. Authenticate with Application Default Credentials:
#      gcloud auth application-default login
#    On Cloud Run: attach a service account with roles/aiplatform.user (or broader for dev).
#    When this is true, GEMINI_API_KEY is not required for Vertex (ADC is used).
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

# Server (local defaults; Cloud Run: set UVICORN_HOST=0.0.0.0, UVICORN_RELOAD=0)
PORT=8080
UVICORN_HOST=127.0.0.1
UVICORN_RELOAD=1

# Optional model overrides (same model IDs work on Developer API and Vertex for most models)
# GEMINI_TEXT_MODEL=gemini-2.5-flash
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts

# Optional: path to knowledge JSON if not next to main.py
# BANKING_KNOWLEDGE_JSON=
