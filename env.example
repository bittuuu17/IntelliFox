# Intellifox AI — Local Dev Config (Vertex AI mode, no API key)
# Copy this to .env:  Copy-Item .env.example .env
# Then run:  gcloud auth application-default login

RUN_ENV=local

# ── Vertex AI (GCP) — recommended for hackathon ───────────────────────────────
# This uses your gcloud credentials locally (no API key needed)
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=YOUR_PROJECT_ID_HERE
GOOGLE_CLOUD_LOCATION=us-central1

# ── Model config (Vertex AI stable models) ────────────────────────────────────
GEMINI_TEXT_MODEL=gemini-2.0-flash-001
GEMINI_IMAGE_MODEL=imagen-3.0-generate-002
GEMINI_TTS_MODEL=gemini-2.0-flash-001

# ── Server (local defaults) ───────────────────────────────────────────────────
PORT=8080
UVICORN_HOST=127.0.0.1
UVICORN_RELOAD=1

# ── Optional: path to knowledge JSON ─────────────────────────────────────────
# BANKING_KNOWLEDGE_JSON=
